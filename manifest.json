{
  "manifest_version": 3,
  "name": "Amazon ISBN Copy",
  "version": "1.1",
  "description": "Copies the ISBN-13 of a book on Amazon (.co.jp, .com, .co.uk) to the clipboard",
  "permissions": [
    "clipboardWrite"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.jp/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
